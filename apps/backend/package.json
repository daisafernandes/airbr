{
  "name": "@airbr/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "clean": "rm -rf dist",
    "import:municipalities": "tsx scripts/import-municipalities.ts"
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "axios": "^1.6.8",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^5.5.9",
    "helmet": "^8.0.0",
    "node-cache": "^5.1.2",
    "tsc-alias": "^1.8.16",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@airbr/eslint-config": "*",
    "@airbr/typescript-config": "*",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node-cache": "^4.1.3",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  }
}
